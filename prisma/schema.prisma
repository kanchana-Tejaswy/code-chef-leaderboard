datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "library"
}

enum UserRole {
  ADMIN
  GK_SIR
  HOD
  STUDENT
}

enum Role {
  STUDENT
  FACULTY
  HOD
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum SyncStatus {
  SUCCESS
  FAILURE
}

enum SyncInitiatedBy {
  SYSTEM_CRON
  USER_MANUAL
  ADMIN_FORCE
}

model StudentProfile {
  id                String            @id @default(uuid())
  name              String
  rollNumber        String?           @unique @map("roll_number")
  department        String?
  year              Int?
  branch            String?
  section           String?
  profilePictureUrl String?           @map("profile_picture_url")
  codechefUsername  String?           @unique @map("codechef_username")
  leetcodeUsername  String?           @unique @map("leetcode_username")
  githubUsername    String?           @unique @map("github_username")
  linkedinUrl       String?           @map("linkedin_url")
  email             String?           @unique
  verificationStatus String            @default("UNABLE_TO_VERIFY") @map("verification_status")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  
  userAccess       UserAccess?
  codechefProfile  CodechefProfile?
  leetcodeProfile  LeetcodeProfile?
  githubProfile    GithubProfile?
  aiAnalysis       AiAnalysis?
  leaderboardEntry LeaderboardEntry?
  syncLogs         SyncLog[]
  activityLogs     ActivityLog[]
  normalizedProfile NormalizedProfile?

  @@index([department])
  @@index([createdAt])
  @@map("student_profiles")
}

model CodechefProfile {
  id                     String         @id @default(uuid())
  studentId              String         @unique @map("student_id")
  student                StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  username               String         @unique
  fullName               String?        @map("full_name")
  country                String?
  institution            String?
  city                   String?
  currentRating          Int?           @map("current_rating")
  highestRating          Int?           @map("highest_rating")
  stars                  Int?           @default(1)
  maxStars               Int?           @map("max_stars")
  globalRank             Int?           @map("global_rank")
  countryRank            Int?           @map("country_rank")
  problemsSolved         Int?           @map("problems_solved")
  fullySolvedCount       Int?           @map("fully_solved_count")
  partiallySolvedCount   Int?           @map("partially_solved_count")
  easySolvedCount        Int?           @map("easy_solved_count")
  mediumSolvedCount      Int?           @map("medium_solved_count")
  hardSolvedCount        Int?           @map("hard_solved_count")
  challengeSolvedCount   Int?           @map("challenge_solved_count")
  contestCount           Int?           @map("contest_count")
  longChallengeCount     Int?           @map("long_challenge_count")
  cookOffCount           Int?           @map("cook_off_count")
  lunchtimeCount         Int?           @map("lunchtime_count")
  startersCount          Int?           @map("starters_count")
  division               String?
  bestContestRank        Int?           @map("best_contest_rank")
  averageContestRank     Float?         @map("average_contest_rank")
  lastActive             DateTime?      @map("last_active")
  activeDaysCount        Int?           @map("active_days_count")
  ratingHistory          Json?          @map("rating_history")
  contestHistory         Json?          @map("contest_history")
  difficultyDistribution Json?          @map("difficulty_distribution")
  activitySummary        Json?          @map("activity_summary")
  statisticDetails       Json?          @map("statistic_details")
  contests               Json?          // Backward compatibility
  verificationMetadata   Json?          @map("verification_metadata")
  lastFetchedAt          DateTime       @default(now()) @map("last_fetched_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("codechef_profiles")
}

model LeetcodeProfile {
  id                     String         @id @default(uuid())
  studentId              String         @unique @map("student_id")
  student                StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  username               String         @unique
  problemsSolved         Int?           @map("problems_solved")
  easySolvedCount        Int?           @map("easy_solved_count")
  mediumSolvedCount      Int?           @map("medium_solved_count")
  hardSolvedCount        Int?           @map("hard_solved_count")
  contestRating          Float?         @map("contest_rating")
  contestRank            Int?           @map("contest_rank")
  acceptanceRate         Float?         @map("acceptance_rate")
  heatmap                Json?          // Calendar heatmap style data
  weeklyActivity         Json?          // Weekly activity details
  skillRadar             Json?          // Skill radar chart values
  tagDistribution        Json?          // Tag distribution pie chart values
  consistencyScore       Float?         @map("consistency_score")
  ratingHistory          Json?          @map("rating_history")
  contestHistory         Json?          @map("contest_history")
  verificationMetadata   Json?          @map("verification_metadata")
  lastFetchedAt          DateTime       @default(now()) @map("last_fetched_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("leetcode_profiles")
}

model GithubProfile {
  id                String         @id @default(uuid())
  studentId         String         @unique @map("student_id")
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  username          String         @unique
  totalRepositories Int?           @map("total_repositories")
  totalStars        Int?           @map("total_stars")
  totalForks        Int?           @map("total_forks")
  followers         Int?
  contributions     Json?          // Contributions graph data
  languages         Json?          // Language distribution pie chart
  repos             Json?          // Top repositories list (clickable)
  commitTimeline    Json?          // Commit timeline data
  openSourceScore   Float?         @map("open_source_score")
  repoQualityScore  Json?          @map("repo_quality_score") // Repository quality score radar data
  verificationMetadata Json?         @map("verification_metadata")
  lastFetchedAt     DateTime       @default(now()) @map("last_fetched_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@map("github_profiles")
}

model AiAnalysis {
  id                          String         @id @default(uuid())
  studentId                   String         @unique @map("student_id")
  student                     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  talentScore                 Float          @default(0) @map("talent_score")
  consistencyScore            Float          @default(0) @map("consistency_score")
  problemSolvingScore         Float          @default(0) @map("problem_solving_score")
  competitiveProgrammingScore Float          @default(0) @map("competitive_programming_score")
  contestScore                Float          @default(0) @map("contest_score")
  learningScore               Float          @default(0) @map("learning_score")
  growthScore                 Float          @default(0) @map("growth_score")
  disciplineScore             Float          @default(0) @map("discipline_score")
  overallPotential            String?        @map("overall_potential")
  placementReadiness          String?        @map("placement_readiness")
  expectedRating6Months       Int?           @map("expected_rating_6_months")
  strengths                   Json?          // String array
  weaknesses                  Json?          // String array
  improvementAreas            Json?          @map("improvement_areas") // String array
  careerRecommendation        String?        @map("career_recommendation")
  suggestedCompanies          Json?          @map("suggested_companies") // String array
  recommendedLearningPath     Json?          @map("recommended_learning_path") // String array
  recommendations             Json?          // Backward compatibility
  careerSuggestions           Json?          // Backward compatibility
  generatedAt                 DateTime       @default(now()) @map("generated_at")
  createdAt                   DateTime       @default(now()) @map("created_at")
  updatedAt                   DateTime       @updatedAt @map("updated_at")

  @@map("ai_analysis")
}

model LeaderboardEntry {
  id             String         @id @default(uuid())
  studentId      String         @unique @map("student_id")
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rank           Int            @default(0)
  rating         Int            @default(0)
  stars          Int            @default(1)
  talentScore    Float          @default(0) @map("talent_score")
  overallScore   Float          @default(0) @map("overall_score")
  codechefScore  Float          @default(0) @map("codechef_score")
  leetcodeScore  Float          @default(0) @map("leetcode_score")
  githubScore    Float          @default(0) @map("github_score")
  trendDirection String         @default("UP") @map("trend_direction")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([rank])
  @@index([talentScore(sort: Desc)])
  @@index([overallScore(sort: Desc)])
  @@index([updatedAt])
  @@index([rating])
  @@index([leetcodeScore])
  @@map("leaderboard_entries")
}

model SyncLog {
  id           String          @id @default(uuid())
  studentId    String          @map("student_id")
  student      StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status       SyncStatus
  errorMessage String?         @map("error_message")
  initiatedBy  SyncInitiatedBy @map("initiated_by")
  durationMs   Int             @map("duration_ms")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@map("sync_logs")
}

model ActivityLog {
  id        String          @id @default(uuid())
  eventType String          @map("event_type")
  studentId String?         @map("student_id")
  student   StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime        @default(now()) @map("created_at")

  @@map("activity_logs")
}

model NormalizedProfile {
  id                   String         @id @default(uuid())
  studentId            String         @unique @map("student_id")
  student              StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  username             String
  platforms            Json           // Holds { codechef: {...}, leetcode: {...}, github: {...} }
  ratingScore          Float          @default(0) @map("rating_score")
  consistencyScore     Float          @default(0) @map("consistency_score")
  problemSolvingScore  Float          @default(0) @map("problem_solving_score")
  activityScore        Float          @default(0) @map("activity_score")
  status               String         @default("COMPLETE") // COMPLETE | PARTIAL
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@map("normalized_profiles")
}

model SyncJob {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  status    String   // PENDING | RUNNING | COMPLETED | FAILED
  error     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sync_jobs")
}

model FetchLog {
  id                 String          @id @default(uuid())
  platform           String
  username           String
  status             String          // SUCCESS | FAILURE
  error              String?
  retryCount         Int             @default(0) @map("retry_count")
  createdAt          DateTime        @default(now()) @map("created_at")

  @@map("fetch_logs")
}

model Profile {
  id         String   @id @default(uuid())
  authUserId String?  @unique @map("auth_user_id")
  name       String
  email      String   @unique
  role       String   @default("STUDENT")
  avatarUrl  String?  @map("avatar_url")
  department String?
  year       Int?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model UserAccess {
  id                    String        @id @default(cuid())
  authUserId            String?       @unique @map("auth_user_id")
  email                 String        @unique
  loginId               String        @unique @map("login_id")
  role                  UserRole
  status                AccountStatus @default(PENDING)
  departmentId          String?       @map("department_id")
  studentProfileId      String?       @unique @map("student_profile_id")
  firstLoginCompleted   Boolean       @default(false) @map("first_login_completed")
  mustSetPassword       Boolean       @default(true) @map("must_set_password")
  approvedBy            String?       @map("approved_by")
  approvedAt            DateTime?     @map("approved_at")
  passwordSetAt         DateTime?     @map("password_set_at")
  lastLoginAt           DateTime?     @map("last_login_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  studentProfile        StudentProfile? @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  auditLogs             AuditLog[]

  @@index([role])
  @@index([status])
  @@index([departmentId])
  @@map("user_access")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("user_id")
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?    @map("details")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  userAccess  UserAccess? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

